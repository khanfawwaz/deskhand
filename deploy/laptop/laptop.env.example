# /etc/deskhand.env (Linux) or %ProgramData%\Deskhand\deskhand.env (Windows). Keep it private (chmod 600).
# Copy the values you already use on the Oracle server (its /etc/*.env file) so sign-in e-mail keeps working.
TASKPILOT_ADMIN_KEY=change-me-long-random
NVIDIA_API_KEY=nvapi-...

# the two-model setup
TASKPILOT_TEXT_MODEL=nvidia/nemotron-3-ultra-550b-a55b
TASKPILOT_VISION_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
TASKPILOT_SPLIT_MODE=describe
TASKPILOT_ALLOW_IMAGES=1

# public address and sign-up (open by default; set TASKPILOT_SIGNUP=closed to stop new people)
TASKPILOT_PUBLIC_URL=https://deskhand.fawwazkhan.dev
#TASKPILOT_SIGNUP=closed
#TASKPILOT_SIGNUP_TASKS_PER_DAY=30
#TASKPILOT_MAX_WORKSPACES=1000

# one shared door to the model API (queue + pacing)
TASKPILOT_MODEL_CONCURRENCY=6        # model calls in flight at once, for everyone
TASKPILOT_MODEL_PER_WORKSPACE=2      # so one busy person cannot take every slot
TASKPILOT_MODEL_RPM=0                # requests per minute your API key allows (0 = no pacing)

# spend cap: prices are dollars per million tokens (read them off your provider's pricing page)
TASKPILOT_PRICE_IN_PER_M=0
TASKPILOT_PRICE_OUT_PER_M=0
TASKPILOT_DAILY_BUDGET_USD=0         # stop all model calls for the day at this spend (needs the prices above); 0 = off
TASKPILOT_DAILY_TOKEN_CAP=0          # or stop at this many tokens whatever they cost; 0 = off
TASKPILOT_WS_TOKENS_PER_DAY=0        # most tokens one workspace may use per day; 0 = off

# sign-in e-mail (copy from the Oracle server)
#TASKPILOT_SMTP_USER=you@gmail.com
#TASKPILOT_SMTP_PASSWORD=app-password
#TASKPILOT_SMTP_HOST=smtp.gmail.com
