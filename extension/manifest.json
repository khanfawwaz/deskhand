{
  "manifest_version": 3,
  "name": "Deskhand",
  "short_name": "Deskhand",
  "version": "1.0.0",
  "minimum_chrome_version": "116",
  "description": "Lets the Deskhand app on your computer carry out web tasks you ask for, in your own signed-in Chrome.",
  "permissions": ["debugger", "tabs", "alarms", "storage"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "Deskhand",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
  },
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
}
